{
  "log": {
    "logLevel": "debug"
  },
  "inbounds": [
    {
      "tag": "tun-in",
      "protocol": "tun",
      "port": 0,
      "settings": {
        "name": "xray0",
        "MTU": 1492
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [ "http", "tls", "quic" ]
      }
    }
  ],
  "outbounds": [
    {
      "protocol": "freedom",
      "tag": "direct-out"
    }
  ]
}
